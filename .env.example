# Copy this file to .env (never versioned) and fill in the values.

# Required outside a throwaway demo: at least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Shared password of the demo accounts (otherwise random, written to .demo_credentials)
DEMO_PASSWORD=

# Demo clock (all synthetic data is anchored on this date)
DEMO_NOW=2026-10-01T10:30:00

# true = the engine journal is visible to the customer (jury demo). false = production.
DEMO_MODE=true
ENABLE_DOCS=false

# Host header allow-list (add your domain when deploying, e.g. my-app.run.app)
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# LLM rendering (optional). Without a key: validated templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Voice (optional). Without a key: the browser's speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

TOKEN_TTL_MINUTES=60
