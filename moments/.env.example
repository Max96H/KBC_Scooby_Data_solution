# Copiez ce fichier en .env (jamais versionné) et remplissez les valeurs.

# Obligatoire en dehors d'une démo locale : 32 caractères minimum.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Mot de passe commun des comptes de démo (sinon : aléatoires, écrits dans .demo_credentials)
DEMO_PASSWORD=

# Horloge de démo (toutes les données synthétiques sont ancrées sur cette date)
DEMO_NOW=2026-10-01T10:30:00

# true = le journal du moteur est visible par le client (démo jury). false = production.
DEMO_MODE=true
ENABLE_DOCS=false

# Rendu LLM (optionnel). Sans clé : gabarits validés.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Voix (optionnel). Sans clé : synthèse vocale du navigateur.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TOKEN_TTL_MINUTES=60
